<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppCleaner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- androidx SplashScreen (PRD §4, Screen 1): teal icon on the theme background. -->
    <style name="Theme.AppCleaner.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AppCleaner</item>
    </style>
</resources>
