<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground (v2): three bold app tiles and, in the fourth slot, a sparkle where
    an app used to be. "Clean up apps" in one glance: the grid is your phone, the empty sparkling
    corner is the space App Cleaner gave back. Everything sits inside the 66dp safe zone.

    The green disc (r = 36, the 72dp visible area) repeats the background layer's gradient with
    identical coordinates, so it is invisible on the launcher. It is there for the splash screen,
    which draws this drawable alone on the white / near-black window background (themes.xml
    windowSplashScreenAnimatedIcon): the system masks the splash icon to exactly that 72dp
    circle, so the user sees a green icon on the theme background (PRD §4 Screen 1) instead of a
    white glyph on white.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M54,18a36,36 0,1 1,0 72a36,36 0,1 1,0 -72z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#22C55E"
                android:endColor="#16A34A" />
        </aapt:attr>
    </path>
    <!-- Grid spans 31..79: shifted 1dp to sit on the optical centre, scaled for breathing room
         inside the 66dp safe circle (every tip and corner stays within r = 33). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.92"
        android:scaleY="0.92"
        android:translateX="-1"
        android:translateY="-1">
        <!-- Three apps staying: 22dp squircles on a 26dp pitch. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M37.5,31h9a6.5,6.5 0,0 1,6.5 6.5v9a6.5,6.5 0,0 1,-6.5 6.5h-9a6.5,6.5 0,0 1,-6.5 -6.5v-9a6.5,6.5 0,0 1,6.5 -6.5z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M37.5,57h9a6.5,6.5 0,0 1,6.5 6.5v9a6.5,6.5 0,0 1,-6.5 6.5h-9a6.5,6.5 0,0 1,-6.5 -6.5v-9a6.5,6.5 0,0 1,6.5 -6.5z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M63.5,57h9a6.5,6.5 0,0 1,6.5 6.5v9a6.5,6.5 0,0 1,-6.5 6.5h-9a6.5,6.5 0,0 1,-6.5 -6.5v-9a6.5,6.5 0,0 1,6.5 -6.5z" />
        <!-- The cleaned slot: a four-point sparkle centred where the fourth tile was (68, 42). -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M68,29.5Q70,40 80.5,42Q70,44 68,54.5Q66,44 55.5,42Q66,40 68,29.5z" />
    </group>
</vector>
