<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background: Spring green, #22C55E top-start to #16A34A bottom-end (design
    system v2). The gradient runs across the 72dp visible area (18..90) and clamps outside it,
    with exactly the same coordinates as the splash disc in ic_launcher_foreground.xml, so the
    two layers are pixel-identical wherever they overlap on the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#22C55E"
                android:endColor="#16A34A" />
        </aapt:attr>
    </path>
</vector>
